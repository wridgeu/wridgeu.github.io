<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="VersionDialog" title="{i18n>versionDialogTitle}" verticalScrolling="false" horizontalScrolling="false">
        <FlexBox class="sapUiSmallMarginTopBottom" justifyContent="Center">
            <FlexBox direction="Column">
                <FlexBox>
                    <Label text="{i18n>versionDialogVersionLabel}" />
                    <Text renderWhitespace="true" text=" {versionInfo>/version}" />
                </FlexBox>
                <FlexBox>
                    <Label text="{i18n>versionDialogNameLabel}" />
                    <Text renderWhitespace="true" text=" {versionInfo>/name}" />
                </FlexBox>
            </FlexBox>
        </FlexBox>
        <endButton>
            <Button text="{i18n>versionDialogClose}" press=".onCloseDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>