<mvc:View controllerName="sapmarco.projectpages.controller.Home" displayBlock="true" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:w="sap.ui.integration.widgets" core:require="{ sapMLib: 'sap/m/library' }">
	<Page showHeader="false">
		<content>
			<l:BlockLayout>
				<l:BlockLayoutRow>
					<l:BlockLayoutCell>
						<VBox>
							<FlexBox alignItems="Center" alignContent="Center" justifyContent="Center" direction="Column">
								<Avatar displaySize="XL" src="./resources/img/src-images/myself.jpg" fallbackIcon="sap-icon://person-placeholder" />
							</FlexBox>
							<l:BlockLayoutCell>
								<FlexBox id="socialsGrouped" class="sapUiTinyMarginTop" justifyContent="Center">
									<!-- core:require https://sapui5.hana.ondemand.com/sdk/#/topic/b11d853a8e784db6b2d210ef57b0f7d7.html -->
									<Link class="socials setMinSeperator socials-linkedin" href="https://linkedin.com/in/dev-marco-beier" target="_blank" rel="noopener noreferrer" text="LinkedIn" tooltip="LinkedIn" />
									<Link class="socials setMinSeperator socials-xing" href="https://xing.com/profile/Marco_Beier8/cv" target="_blank" rel="noopener noreferrer" text="Xing" tooltip="Xing" />
									<Link class="socials setMinSeperator socials-github" href="https://github.com/wridgeu" target="_blank" rel="noopener noreferrer" text="GitHub" tooltip="GitHub" />
									<Link class="socials setMinSeperator socials-twitter" href="https://twitter.com/Wridgeu" target="_blank" rel="noopener noreferrer" text="Twitter" tooltip="Twitter" />
									<Link class="socials setMinSeperator socials-bluesky" href="https://bsky.app/profile/wridgeu.bsky.social" target="_blank" rel="noopener noreferrer" text="Bluesky" tooltip="Bluesky" />
									<Link class="socials setMinSeperator socials-sap" href="https://people.sap.com/marcobeier" target="_blank" rel="noopener noreferrer" text="SAP Community" tooltip="SAP Community" />
								</FlexBox>
							</l:BlockLayoutCell>
						</VBox>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
				<l:BlockLayoutRow>
					<l:BlockLayoutCell>
						<FlexBox class="setMiddle" width="100%">
							<Text class="text" text="{i18n>homeIntroText}" />
						</FlexBox>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
				<l:BlockLayoutRow class="setMiddle" id="cVRow">
					<l:BlockLayoutCell>
						<FlexBox width="100%">
							<Text class="text" text="{i18n>homeAboutText}" />
						</FlexBox>
					</l:BlockLayoutCell>
					<l:BlockLayoutCell>
						<FlexBox direction="Column">
							<FlexBox justifyContent="Center">
								<Tree items="{path: 'cv>/', parameters:{arrayNames: ['nodes']}}">
									<layoutData>
										<FlexItemData growFactor="1" />
									</layoutData>
									<CustomTreeItem>
										<Text renderWhitespace="true" text="{cv>description}" />
										<Link href="{cv>website}" text="{cv>company}" target="_blank" />
										<Label wrapping="true" text="{cv>position}" />
										<FlexBox direction="Column">
											<FlexBox>
												<Text renderWhitespace="true" text="{cv>textTo}" />
												<Label text="{cv>to}" />
											</FlexBox>
											<FlexBox>
												<Text renderWhitespace="true" text="{cv>textFrom}" />
												<Label text="{cv>from}" />
											</FlexBox>
										</FlexBox>
									</CustomTreeItem>
								</Tree>
							</FlexBox>
						</FlexBox>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
				<l:BlockLayoutRow>
					<l:BlockLayoutCell>
						<FlexBox class="sapUiLargeMarginTop setMiddle" width="100%" direction="Column" alignItems="Center">
							<Text class="title" text="{i18n>homeSkillsTitle}" />
							<Text text="{i18n>homeSkillsSubtitle}" />
						</FlexBox>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
				<l:BlockLayoutRow>
					<l:BlockLayoutCell id="integrationcards-container">
						<FlexBox wrap="Wrap" justifyContent="Center" alignItems="Center">
							<w:Card class="integrationcard" dataMode="Active" manifest="./integrationcards/datacard-sap-manifest.json" width="250px" height="auto" />
							<w:Card class="integrationcard" dataMode="Active" manifest="./integrationcards/datacard-tools-manifest.json" width="250px" height="auto" />
							<w:Card class="integrationcard" dataMode="Active" manifest="./integrationcards/datacard-lang-manifest.json" width="250px" height="auto" />
						</FlexBox>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
				<l:BlockLayoutRow>
					<l:BlockLayoutCell>
						<HBox justifyContent="Center">
							<Text class="title" text="{i18n>homeMiscTitle}" />
						</HBox>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
				<l:BlockLayoutRow>
					<l:BlockLayoutCell>
						<HBox justifyContent="Center">
							<GenericTile class="tile-text-color tile-image-position sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="{i18n>homeWikiTileHeader}" press=".onWiki" subheader="{i18n>homeWikiTileSubheader}" backgroundImage="./resources/img/webp/library.webp"></GenericTile>
							<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="{i18n>homeUI5ConTileHeader}" press=".onUI5con" subheader="{i18n>homeUI5ConTileSubheader}" backgroundImage="./resources/img/webp/UI5con-Black.webp"></GenericTile>
						</HBox>
					</l:BlockLayoutCell>
				</l:BlockLayoutRow>
			</l:BlockLayout>
		</content>
		<footer>
			<Toolbar id="footerToolbar" design="Solid">
				<core:Icon src="sap-icon://lightbulb" class="size2" press=".toggleTheme" tooltip="{i18n>themeToggleTooltip}" />
				<ToolbarSpacer />
				<Text class="footerText" text="{i18n>footerText}">
					<layoutData>
						<ToolbarLayoutData shrinkable="true" />
					</layoutData>
				</Text>
				<ToolbarSpacer />
				<core:Icon src="sap-icon://sap-ui5" class="size2" press=".onUI5IconPress" tooltip="{i18n>homeVersionTooltip}" />
			</Toolbar>
		</footer>
	</Page>
</mvc:View>