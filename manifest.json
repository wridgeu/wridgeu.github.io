{
	"_version": "2.0.0",
	"sap.app": {
		"id": "sapmarco.projectpages",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				"",
				"de",
				"de-DE",
				"en",
				"en-US"
			]
		},
		"applicationVersion": {
			"version": "1.25.1"
		},
		"serviceWorker": {
			"file": "sw.js",
			"config": [
				{
					"url": "https://wridgeu.github.io",
					"type": "application"
				},
				{
					"url": "https://raw.githubusercontent.com/wiki/wridgeu",
					"type": "networkupdate"
				}
			]
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"dataSources": {
			"cv": {
				"uri": "model/cv.json",
				"type": "JSON"
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": [
			"sap_horizon",
			"sap_horizon_dark"
		]
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "sapmarco.projectpages.view.Shell",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.152.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {
					"lazy": true
				},
				"sap.ui.integration": {
					"lazy": true
				}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "sapmarco.projectpages.i18n.i18n",
					"supportedLocales": [
						"de",
						"en"
					],
					"fallbackLocale": "en",
					"async": true
				}
			},
			"cv": {
				"type": "sap.ui.model.json.JSONModel",
				"dataSource": "cv"
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				},
				{
					"uri": "css/ocean.minified.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "sapmarco.projectpages.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"name": "RouteMain",
					"pattern": "",
					"target": [
						"TargetMain"
					]
				},
				{
					"name": "RouteWiki",
					"pattern": "wiki",
					"target": [
						"TargetWiki"
					]
				},
				{
					"name": "RouteUI5Con",
					"pattern": "UI5Con2022",
					"target": [
						"TargetUI5Con"
					]
				}
			],
			"targets": {
				"TargetMain": {
					"viewType": "XML",
					"id": "Home",
					"level": 1,
					"name": "Home"
				},
				"TargetWiki": {
					"viewType": "XML",
					"id": "Wiki",
					"level": 2,
					"name": "Wiki"
				},
				"TargetUI5Con": {
					"viewType": "XML",
					"id": "UI5Con",
					"level": 2,
					"name": "UI5Con"
				}
			}
		},
		"flexBundle": false
	}
}